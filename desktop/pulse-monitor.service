[Unit]
Description=Pulse resource monitor and top-panel indicator
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=@RUN_SCRIPT@ --backend
Restart=on-failure
RestartSec=2
TimeoutStopSec=8
KillMode=control-group
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target
